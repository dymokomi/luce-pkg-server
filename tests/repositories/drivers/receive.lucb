import repositories
from luce_db import db
from luce_auth import auth
from luce_prism import prism
from luce_git import git
import c
from luce_std import files, paths
import memory
import strings

var zero: u8[20]

## One release of alice/push as a push carries it: package.prisma, its tree, a commit with
## no parent or with `parent`, and the annotated tag `v<version>` naming that commit.
struct Release:
    var definition: u8[256]
    var definition_size: usize
    var tree: u8[64]
    var tree_size: usize
    var commit: u8[512]
    var commit_size: usize
    var tag: u8[256]
    var tag_size: usize
    var tag_id: u8[20]
    var commit_id: u8[20]

    func objects(output: git.Object[4]*):
        (*output)[0] = git.Object(kind = "blob", payload = self.definition[..<self.definition_size])
        (*output)[1] = git.Object(kind = "tree", payload = self.tree[..<self.tree_size])
        (*output)[2] = git.Object(kind = "commit", payload = self.commit[..<self.commit_size])
        (*output)[3] = git.Object(kind = "tag", payload = self.tag[..<self.tag_size])

func release(version: str, parent: const u8[]) -> Release!:
    var made: Release
    made.definition_size = (try strings.format(made.definition, f"#prisma 4.0\ndef package \"push\" {{\n    str owner = \"alice\"\n    str version = \"{version}\"\n    str kind = \"package\"\n    str language = \"luce-base\"\n    str description = \"Receive fixture\"\n}}\n")).length
    var blob: u8[20]
    _ = try git.hash_object("blob", made.definition[..<made.definition_size], blob)
    made.tree_size = try git.encode_tree_entry(git.TreeEntry(mode = "100644", name = "package.prisma", id = blob), made.tree)
    var tree_id: u8[20]
    _ = try git.hash_object("tree", made.tree[..<made.tree_size], tree_id)
    var tree_text: u8[40]
    _ = try git.hex_id(tree_id, tree_text)
    var parent_text: u8[40]
    var parent_line: u8[64]
    var parents = ""
    if parent.length == 20:
        _ = try git.hex_id(parent, parent_text)
        parents = try strings.format(parent_line, f"parent {(str)parent_text}\n")
    made.commit_size = (try strings.format(made.commit, f"tree {(str)tree_text}\n{parents}author A <a@b> 1 +0000\ncommitter A <a@b> 1 +0000\n\npush {version}\n")).length
    _ = try git.hash_object("commit", made.commit[..<made.commit_size], made.commit_id)
    var commit_text: u8[40]
    _ = try git.hex_id(made.commit_id, commit_text)
    made.tag_size = (try strings.format(made.tag, f"object {(str)commit_text}\ntype commit\ntag v{version}\n\nrelease {version}\n")).length
    _ = try git.hash_object("tag", made.tag[..<made.tag_size], made.tag_id)
    return made

func append(wire: u8[], at: usize, old: const u8[], target: const u8[], name: str, caps: str, initial: bool) -> usize!:
    var old_text: u8[40]
    var new_text: u8[40]
    _ = try git.hex_id(old, old_text)
    _ = try git.hex_id(target, new_text)
    var buffer: u8[1024]
    let separator = "\0" if initial else ""
    let line = try strings.format(buffer, f"{(str)old_text} {(str)new_text} {name}{separator}{caps}")
    return at + try git.encode_packet(git.PacketKind.data, line.bytes, wire[at..])

## One ref command, then the pack of `objects`.
func push_wire(wire: u8[], old: const u8[], target: const u8[], name: str, objects: const git.Object[], caps: str = "report-status atomic ofs-delta") -> usize!:
    var n = try append(wire, 0, old, target, name, caps, true)
    n += try git.encode_packet(git.PacketKind.flush, b"", wire[n..])
    n += try git.encode_pack(objects, wire[n..])
    return n

func expect(database: db.Database*, name: str, id: const u8[]) -> !:
    let ref = try repositories.get_ref(database, "alice", "alice", "push", name)
    defer ref.release()
    let bytes = ref.value().bytes()
    for i in 0..<(usize)20: assert(bytes[i] == id[i])

func absent(database: db.Database*, name: str) -> !:
    let ref = repositories.get_ref(database, "alice", "alice", "push", name) catch failure:
        assert(failure.code == prism.missing)
        return
    ref.release()
    assert(false)

## The push is refused and the database is as it was; with `reason`, the refusal is one
## the pusher is told, starting `release: `.
func no_writes(database: db.Database*, wire: const u8[], site: str, reason: bool = false) -> !:
    let before = try database.snapshot()
    defer before.release()
    var failed = false
    _ = repositories.receive_pack(database, "alice", "alice", "push", wire, site) catch failure:
        if reason: assert(strings.starts_with(failure.message, "release: "))
        failed = true
        recover 0
    assert(failed)
    let after = try database.snapshot()
    defer after.release()
    assert(try before.value().revision() == try after.value().revision())

func cases(database: db.Database*, site: str) -> !:
    let advertisement = try new u8[2097152] --- in memory.heap
    defer free(advertisement) in memory.heap
    let empty_advertisement = try repositories.advertise_receive(database, "alice", "alice", "push", advertisement)
    let offered = (str)advertisement[..<empty_advertisement]
    assert(strings.contains(offered, "capabilities^{}") and not strings.contains(offered, "delete-refs"))
    var first = try release("1.0.0", b"")
    var objects: git.Object[4]
    first.objects(&objects)
    var wire: u8[16384]
    var n = try push_wire(wire, zero, first.tag_id, "refs/tags/v1.0.0", objects)
    # Without a site to publish to, nothing is taken.
    try no_writes(database, wire[..<n], "", reason = true)
    wire[n - 1] ^= 1
    try no_writes(database, wire[..<n], site)
    wire[n - 1] ^= 1
    var denied = false
    _ = repositories.receive_pack(database, "bob", "alice", "push", wire[..<n], site) catch:
        denied = true
        recover 0
    assert(denied)
    assert(try repositories.receive_pack(database, "alice", "alice", "push", wire[..<n], site) == 1)
    try expect(database, "refs/tags/v1.0.0", first.tag_id)
    let pack_file = try paths.join(site, "alice/push/1.0.0.pack")
    defer pack_file.release()
    assert(files.exists((c.str)pack_file.value))
    let advertised = try repositories.advertise_receive(database, "alice", "alice", "push", advertisement)
    assert(strings.contains((str)advertisement[..<advertised], "refs/tags/v1.0.0"))
    var too_small = false
    _ = repositories.advertise_receive(database, "alice", "alice", "push", advertisement[..<4]) catch:
        too_small = true
        recover 0
    assert(too_small)
    # A release is created once: the same push again changes nothing.
    try no_writes(database, wire[..<n], site)
    n = try push_wire(wire, zero, first.tag_id, "refs/tags/v1.0.1", objects[..<0], "side-band-64k")
    try no_writes(database, wire[..<n], site)
    # Only the creation of a release tag is taken: no branch, no other tag, no move, no
    # deletion, and a batch holding any of them is refused whole.
    var second = try release("1.0.1", first.commit_id)
    second.objects(&objects)
    n = try push_wire(wire, zero, second.commit_id, "refs/heads/main", objects)
    try no_writes(database, wire[..<n], site, reason = true)
    n = try push_wire(wire, zero, second.tag_id, "refs/tags/keep", objects)
    try no_writes(database, wire[..<n], site, reason = true)
    n = try push_wire(wire, first.tag_id, second.tag_id, "refs/tags/v1.0.0", objects)
    try no_writes(database, wire[..<n], site, reason = true)
    n = try append(wire, 0, first.tag_id, zero, "refs/tags/v1.0.0", "report-status atomic", true)
    n += try git.encode_packet(git.PacketKind.flush, b"", wire[n..])
    try no_writes(database, wire[..<n], site, reason = true)
    n = try append(wire, 0, zero, second.tag_id, "refs/tags/v1.0.1", "report-status atomic ofs-delta", true)
    n = try append(wire, n, zero, second.commit_id, "refs/heads/main", "", false)
    n += try git.encode_packet(git.PacketKind.flush, b"", wire[n..])
    n += try git.encode_pack(objects, wire[n..])
    try no_writes(database, wire[..<n], site, reason = true)
    try absent(database, "refs/tags/v1.0.1")
    # The next release names the first commit as its parent, which is history: it is
    # neither required nor followed, and the release still publishes.
    n = try push_wire(wire, zero, second.tag_id, "refs/tags/v1.0.1", objects)
    assert(try repositories.receive_pack(database, "alice", "alice", "push", wire[..<n], site) == 1)
    try expect(database, "refs/tags/v1.0.1", second.tag_id)
    try expect(database, "refs/tags/v1.0.0", first.tag_id)
    # Structurally valid but disconnected commit: staging may persist it, refs may not.
    var broken = try release("1.2.0", b"")
    let missing_tree = b"tree 1111111111111111111111111111111111111111\nauthor A\ncommitter A\n\nbroken\n"
    _ = try git.hash_object("commit", missing_tree, broken.commit_id)
    var commit_text: u8[40]
    _ = try git.hex_id(broken.commit_id, commit_text)
    broken.tag_size = (try strings.format(broken.tag, f"object {(str)commit_text}\ntype commit\ntag v1.2.0\n\nbroken\n")).length
    _ = try git.hash_object("tag", broken.tag[..<broken.tag_size], broken.tag_id)
    objects[0] = git.Object(kind = "commit", payload = missing_tree)
    objects[1] = git.Object(kind = "tag", payload = broken.tag[..<broken.tag_size])
    n = try push_wire(wire, zero, broken.tag_id, "refs/tags/v1.2.0", objects[..<2])
    denied = false
    _ = repositories.receive_pack(database, "alice", "alice", "push", wire[..<n], site) catch:
        denied = true
        recover 0
    assert(denied)
    try absent(database, "refs/tags/v1.2.0")

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 3)
    let database = try db.Database.open(arguments[1], "receive-test")
    try repositories.use_objects(arguments[1])
    defer database.release()
    if arguments[2] == "read":
        let first = try release("1.0.0", b"")
        let second = try release("1.0.1", first.commit_id)
        try expect(database.value(), "refs/tags/v1.0.0", first.tag_id)
        try expect(database.value(), "refs/tags/v1.0.1", second.tag_id)
        try absent(database.value(), "refs/tags/v1.2.0")
    else:
        let authority = try auth.Authority.attach(try database.value().store())
        defer authority.release()
        try authority.value().bootstrap("alice", "receive-fixture-password")
        try repositories.initialize(database.value())
        try repositories.create(database.value(), "alice", "push")
        var site_buffer: u8[512]
        let site = try strings.format(site_buffer, f"{arguments[1]}.site")
        if arguments[2] == "ipc":
            try database.value().listen()
            var socket_buffer: u8[512]
            let socket = try strings.format(socket_buffer, f"{arguments[1]}.sock")
            let client = try db.Database.connect(socket, "receive-test")
            defer client.release()
            try cases(client.value(), site)
        else: try cases(database.value(), site)
    print("PASS repository receive: release tags only, pack validation, CAS, graph atomicity and reopen")
    return 0
