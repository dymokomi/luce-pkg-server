import profile_api as api

let marker: ErrorCode = ErrorCode.package(73)

pub func main(arguments: str[]) -> i32:
    assert(arguments.length == 3)
    assert(arguments[1] == "argument with spaces" and arguments[2] == "; literal dollar$")
    assert(api.answer() == 42 and api.caught())
    assert(api.marker != marker and api.core_marker() != marker and api.core_marker() != api.marker)
    print("PASS compiler profile 42")
    return 0
