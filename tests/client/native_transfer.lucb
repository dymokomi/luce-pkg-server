import http_client
import net
import git
import files
import memory

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    var port: u16
    for byte in arguments[1].bytes:
        assert(byte >= '0' and byte <= '9')
        port = port * 10 + (u16)(byte - '0')
    var token: u8[32]
    let session = try http_client.post(port, "/v1/sessions",
        b"{\"name\":\"testuser\",\"password\":\"fixture-pass\"}", token)
    assert(session.status == 200 and session.count == token.length)
    var authorization_buffer: u8[64]
    let authorization = try format(authorization_buffer, f"Bearer {(str)token}")
    var headers: net.HttpField[1]
    headers[0] = net.HttpField(name = "Authorization", value = authorization)
    var small: u8[128]
    let created = try http_client.request(net.SocketAddress.loopback(port), "POST", "/v1/repositories",
        "127.0.0.1", headers, 1, b"{\"name\":\"native-transfer\"}", small)
    assert(created.status == 201 or created.status == 409)
    let source = try files.read_limit("../luce-base/bootstrap/luce-base-arm64-macos.c", 33554432)
    defer free(source) in memory.heap
    assert(source.length > 1048576)
    let wire = try alloc u8[source.length + 32] in memory.heap
    defer free(wire) in memory.heap
    let length = try git.encode_object("blob", source, wire)
    var id: u8[20]
    discard(try git.hash_blob(source, id))
    var encoded: u8[40]
    discard(try git.hex_id(id, encoded))
    var path_buffer: u8[160]
    let path = try format(path_buffer, f"/v1/repositories/testuser/native-transfer/objects/{(str)encoded}")
    let uploaded = try http_client.request(net.SocketAddress.loopback(port), "PUT", path,
        "127.0.0.1", headers, 1, wire[..<length], small)
    assert(uploaded.status == 200 and (str)small[..<uploaded.count] == (str)encoded)
    let received = try alloc u8[length] in memory.heap
    defer free(received) in memory.heap
    let downloaded = try http_client.request(net.SocketAddress.loopback(port), "GET", path,
        "127.0.0.1", headers, 1, b"", received)
    assert(downloaded.status == 200 and downloaded.count == length)
    for i in 0..<length: assert(received[i] == wire[i])
    let decoded = try git.decode_object(received)
    assert(decoded.kind == "blob" and decoded.payload.length == source.length)
    var actual: u8[20]
    discard(try git.hash_object(decoded.kind, decoded.payload, actual))
    for i in 0..<(usize)20: assert(actual[i] == id[i])
    let revoked = try http_client.request(net.SocketAddress.loopback(port), "POST", "/v1/sessions/revoke",
        "127.0.0.1", headers, 1, b"", small)
    assert(revoked.status == 200)
    let denied = try http_client.request(net.SocketAddress.loopback(port), "GET", path,
        "127.0.0.1", headers, 1, b"", small)
    assert(denied.status == 401)
    print("PASS native client login/create/upload/download/hash/revoke of real compiler source")
    return 0
