import repositories
import db
import auth
import prism
import git
import thread

var zero: u8[20]
var first_id: u8[20]
var second_id: u8[20]
var third_id: u8[20]
var socket_buffer: u8[512]
var socket_length: usize

let first_commit = b"tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\nauthor Fixture <test@example.test> 1 +0000\ncommitter Fixture <test@example.test> 1 +0000\n\nfirst\n"
let second_commit = b"tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\nparent 21a034102c2fedf44187c5db3b8fdf380a6e0f5f\nauthor Fixture <test@example.test> 2 +0000\ncommitter Fixture <test@example.test> 2 +0000\n\nsecond\n"
let third_commit = b"tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\nparent 074900058fa851c4e0520094fbd88c162513d1a3\nauthor Fixture <test@example.test> 3 +0000\ncommitter Fixture <test@example.test> 3 +0000\n\nthird\n"

func identify() -> !:
    discard(try git.hash_object("commit", first_commit, first_id))
    discard(try git.hash_object("commit", second_commit, second_id))
    discard(try git.hash_object("commit", third_commit, third_id))

func change(name: str, expected: const u8[], target: const u8[]) -> repositories.RefUpdate:
    return repositories.RefUpdate(name = name, expected = expected, target = target)

func seed(database: db.Database*, name: str) -> !:
    let authority = try auth.Authority.attach(try database.store())
    defer authority.release()
    try authority.value().bootstrap("alice", "disposable-pull-request-password")
    try repositories.initialize(database)
    try repositories.create(database, "alice", name)
    var wire: u8[512]
    var result: u8[20]
    var n = try git.encode_object("tree", b"", wire)
    try repositories.put_object(database, "alice", "alice", name, wire[..<n], result)
    n = try git.encode_object("commit", first_commit, wire)
    try repositories.put_object(database, "alice", "alice", name, wire[..<n], result)
    n = try git.encode_object("commit", second_commit, wire)
    try repositories.put_object(database, "alice", "alice", name, wire[..<n], result)
    n = try git.encode_object("commit", third_commit, wire)
    try repositories.put_object(database, "alice", "alice", name, wire[..<n], result)
    try repositories.update_refs(database, "alice", "alice", name,
        [change("refs/heads/main", zero, first_id), change("refs/heads/feature", zero, second_id)])

func same(left: const u8[], right: const u8[]) -> bool:
    if left.length != right.length: return false
    for i in 0..<left.length:
        if left[i] != right[i]: return false
    return true

func expect(database: db.Database*, number: i64, state: repositories.PullRequestState,
    title: str, base_id: const u8[], head_id: const u8[], merge_id: const u8[]) -> !:
    var record: repositories.PullRequest
    try repositories.get_pull_request(database, "alice", "alice", "demo", number, &record)
    assert(record.number == number and record.state == state)
    assert((str)record.author[..<record.author_length] == "alice")
    assert((str)record.title[..<record.title_length] == title)
    assert((str)record.base[..<record.base_length] == "main")
    assert((str)record.head[..<record.head_length] == "feature")
    assert(same(record.base_id, base_id) and same(record.head_id, head_id) and same(record.merge_id, merge_id))
    assert(record.created_at > 0 and record.updated_at >= record.created_at)

func reject_create(database: db.Database*, base: str, head: str, title: str, body: str, expected: ErrorCode) -> !:
    let value = repositories.create_pull_request(database, "alice", "alice", "demo", base, head, title, body) catch failure:
        assert(failure.code == expected)
        return
    discard(value)
    assert(false)

func reject_state(database: db.Database*, number: i64, state: repositories.PullRequestState, expected: ErrorCode) -> !:
    repositories.set_pull_request_state(database, "alice", "alice", "demo", number, state) catch failure:
        assert(failure.code == expected)
        return
    assert(false)

func write(database: db.Database*, prepare: bool = true) -> !:
    if prepare: try seed(database, "demo")
    let first = try repositories.create_pull_request(database, "alice", "alice", "demo",
        "main", "feature", "Review π", "Line one\nLine two")
    assert(first == 1)
    try expect(database, 1, .open, "Review π", first_id, second_id, zero)
    try reject_create(database, "main", "feature", "duplicate", "", prism.conflict)
    for branch in ["", "../main", "refs/heads/main", "bad.lock"]:
        try reject_create(database, branch, "feature", "bad branch", "", prism.invalid)
    try reject_create(database, "main", "main", "same branch", "", prism.invalid)
    try reject_create(database, "main", "feature", "", "", prism.invalid)
    try reject_create(database, "main", "feature", "bad\nheading", "", prism.invalid)
    var long_title: u8[257]
    for i in 0..<long_title.length: long_title[i] = 'x'
    try reject_create(database, "main", "feature", (str)long_title, "", prism.invalid)
    var long_body: u8[8193]
    for i in 0..<long_body.length: long_body[i] = 'x'
    try reject_create(database, "main", "feature", "oversized body", (str)long_body, prism.invalid)
    try repositories.set_pull_request_state(database, "alice", "alice", "demo", 1, .closed)
    try expect(database, 1, .closed, "Review π", first_id, second_id, zero)
    try repositories.set_pull_request_state(database, "alice", "alice", "demo", 1, .open)
    try expect(database, 1, .open, "Review π", first_id, second_id, zero)
    try repositories.set_pull_request_state(database, "alice", "alice", "demo", 1, .closed)
    let second = try repositories.create_pull_request(database, "alice", "alice", "demo",
        "main", "feature", "Replacement", "")
    assert(second == 2)
    try reject_state(database, 2, .merged, prism.conflict)
    try repositories.update_refs(database, "alice", "alice", "demo",
        [change("refs/heads/main", first_id, third_id)])
    try repositories.set_pull_request_state(database, "alice", "alice", "demo", 2, .merged)
    try expect(database, 2, .merged, "Replacement", first_id, second_id, third_id)
    try reject_state(database, 2, .open, prism.conflict)
    var records: repositories.PullRequest[2]
    let count = try repositories.list_pull_requests(database, "alice", "alice", "demo", records)
    assert(count == 2 and records[0].number == 2 and records[1].number == 1)
    var short: repositories.PullRequest[1]
    var bounded = false
    discard(repositories.list_pull_requests(database, "alice", "alice", "demo", short) catch failure:
        assert(failure.code == prism.invalid)
        bounded = true
        recover 0)
    assert(bounded)
    var denied = false
    discard(repositories.create_pull_request(database, "mallory", "alice", "demo",
        "main", "feature", "stolen", "") catch failure:
        assert(failure.code == prism.invalid)
        denied = true
        recover 0)
    assert(denied)

func read(database: db.Database*) -> !:
    try expect(database, 1, .closed, "Review π", first_id, second_id, zero)
    try expect(database, 2, .merged, "Replacement", first_id, second_id, third_id)
    var records: repositories.PullRequest[2]
    assert(try repositories.list_pull_requests(database, "alice", "alice", "demo", records) == 2)

var ready: @u64
var start: @u64
var successes: @u64
var conflicts: @u64
var unexpected: @u64

func race_attempt() -> !:
    let database = try db.Database.connect((str)socket_buffer[..<socket_length], "pull-request-test-token")
    defer database.release()
    while start.load(.acquire) == 0: thread.sleep(1)
    discard(repositories.create_pull_request(database.value(), "alice", "alice", "race",
        "main", "feature", "Concurrent", "") catch failure:
        if failure.code == prism.conflict: discard(conflicts.add(1, .relaxed))
        else: discard(unexpected.add(1, .relaxed))
        return)
    discard(successes.add(1, .relaxed))

func race_worker(raw: void*?):
    discard(raw)
    discard(ready.add(1, .release))
    race_attempt() catch: discard(unexpected.add(1, .relaxed))

func race(database: db.Database*) -> !:
    try seed(database, "race")
    try database.listen()
    var one = try thread.spawn(race_worker, none, name = "pull-one")
    var two = try thread.spawn(race_worker, none, name = "pull-two")
    while ready.load(.acquire) != 2: thread.sleep(1)
    start.store(1, .release)
    try one.join()
    try two.join()
    assert(successes.load(.acquire) == 1 and conflicts.load(.acquire) == 1 and unexpected.load(.acquire) == 0)

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 3)
    try identify()
    let database = try db.Database.open(arguments[1], "pull-request-test-token")
    defer database.release()
    let path = arguments[1]
    assert(path.length + 5 <= socket_buffer.length)
    for i in 0..<path.length: socket_buffer[i] = path.bytes[i]
    for i in 0..<(usize)5: socket_buffer[path.length + i] = b".sock"[i]
    socket_length = path.length + 5
    if arguments[2] == "read": try read(database.value())
    elif arguments[2] == "race": try race(database.value())
    elif arguments[2] == "ipc":
        try seed(database.value(), "demo")
        try database.value().listen()
        let client = try db.Database.connect((str)socket_buffer[..<socket_length], "pull-request-test-token")
        defer client.release()
        try write(client.value(), false)
    else: try write(database.value())
    print("PASS repository pull requests")
    return 0
