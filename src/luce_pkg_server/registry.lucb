## Loopback registry API. Reverse-proxy headers never establish identity.
import http
import interop
import db
import auth
import ownership
import json
import os
import c
import strings
import repositories
import git
import memory

func failed(code: ErrorCode, message: str) -> interop.Outcome[interop.Reference[http.Response]]:
    let copied = interop.copy_text(message) catch failure:
        return interop.Outcome[interop.Reference[http.Response]].failure(failure.code, interop.Owned[str]("internal error"))
    return interop.Outcome[interop.Reference[http.Response]].failure(code, copied)

func reply(text: str, status: i64 = 200) -> interop.Outcome[interop.Reference[http.Response]]:
    return binary_reply(text.bytes, "text/plain; charset=utf-8", status)

func binary_reply(bytes: const u8[], content_type: str, status: i64 = 200) -> interop.Outcome[interop.Reference[http.Response]]:
    let value = http.Response.bytes(bytes, content_type, status) catch failure:
        return failed(failure.code, "internal error")
    value.value().header("Cache-Control", "no-store") catch failure:
        value.release()
        return failed(failure.code, "internal error")
    return interop.Outcome[interop.Reference[http.Response]].success(interop.Owned[interop.Reference[http.Response]](value, &value.owner.header))

func valid_token(token: str) -> bool:
    if token.length != 32: return false
    for byte in token.bytes:
        if not ((byte >= '0' and byte <= '9') or (byte >= 'a' and byte <= 'f')): return false
    return true

func bearer(request: const http.Request*) -> str!:
    let header = (try request.header("Authorization")) else error(auth.invalid, "authentication required")
    if not strings.starts_with(header, "Bearer "): error(auth.invalid, "authentication required")
    let token = (str)header.bytes[7..]
    if not valid_token(token): error(auth.invalid, "authentication required")
    return token

func field(root: json.View, name: str) -> str!:
    let value = root.member(name) else error(auth.invalid, "missing field")
    return value.text() else error(auth.invalid, "string field required")

struct App:
    var database: interop.Reference[db.Database]
    var authority: interop.Reference[auth.Authority]

    mutating func close():
        self.authority.release()
        self.database.release()

    func health(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        discard(view)
        return reply("ok")

    func identity(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let token = bearer(view.value()) catch: return reply("unauthorized", 401)
        let who = self.authority.value().verify(token) catch: return reply("unauthorized", 401)
        defer who.release()
        let name = who.value().text_at() catch: return reply("internal error", 500)
        return reply(name)

    func redeem(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let body = view.value().body() catch: return reply("invalid body", 400)
        defer body.release()
        let payload = body.value().bytes(4096) catch: return reply("invalid body", 400)
        let document = json.decode((str)payload, 4096) catch: return reply("invalid JSON", 400)
        defer document.release()
        let root = document.value().root()
        if root.kind() != json.Kind.object or root.length() != 3: return reply("invalid fields", 400)
        let code = field(root, "code") catch: return reply("invalid fields", 400)
        let name = field(root, "name") catch: return reply("invalid fields", 400)
        let password = field(root, "password") catch: return reply("invalid fields", 400)
        if not valid_token(code): return reply("invalid invitation", 400)
        self.authority.value().accept(code, name, password) catch failure:
            if failure.code == auth.conflict: return reply("registration conflict", 409)
            if failure.code == auth.invalid: return reply("invalid registration", 400)
            return reply("registration failed", 503)
        return reply("registered", 201)

    func login(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let body = view.value().body() catch: return reply("invalid body", 400)
        defer body.release()
        let payload = body.value().bytes(4096) catch: return reply("invalid body", 400)
        let document = json.decode((str)payload, 4096) catch: return reply("invalid JSON", 400)
        defer document.release()
        let root = document.value().root()
        if root.kind() != json.Kind.object or root.length() != 2: return reply("invalid fields", 400)
        let name = field(root, "name") catch: return reply("invalid fields", 400)
        let password = field(root, "password") catch: return reply("invalid fields", 400)
        let token = self.authority.value().login(name, password) catch failure:
            if failure.code == auth.busy: return reply("authentication busy", 503)
            return reply("unauthorized", 401)
        defer token.release()
        let text = token.value().text_at() catch: return reply("internal error", 500)
        return reply(text)

    func logout(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let token = bearer(view.value()) catch: return reply("unauthorized", 401)
        self.authority.value().revoke(token) catch: return reply("unauthorized", 401)
        return reply("revoked")

    func create_repository(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let token = bearer(view.value()) catch: return reply("unauthorized", 401)
        let who = self.authority.value().verify(token) catch: return reply("unauthorized", 401)
        defer who.release()
        let principal = who.value().text_at() catch: return reply("internal error", 500)
        let body = view.value().body() catch: return reply("invalid body", 400)
        defer body.release()
        let payload = body.value().bytes(4096) catch: return reply("invalid body", 400)
        let document = json.decode((str)payload, 4096) catch: return reply("invalid JSON", 400)
        defer document.release()
        let root = document.value().root()
        if root.kind() != json.Kind.object or root.length() != 1: return reply("invalid fields", 400)
        let name = field(root, "name") catch: return reply("invalid fields", 400)
        repositories.create(self.database.value(), principal, name) catch failure:
            if failure.code == auth.invalid: return reply("invalid repository", 400)
            if failure.code == auth.conflict: return reply("repository conflict", 409)
            return reply("repository creation failed", 503)
        return reply("created", 201)

    func object(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let request = view.value()
        let token = bearer(request) catch: return reply("unauthorized", 401)
        let who = self.authority.value().verify(token) catch: return reply("unauthorized", 401)
        defer who.release()
        let principal = who.value().text_at() catch: return reply("internal error", 500)
        let owner = request.parameter("owner") else return reply("invalid path", 400)
        let name = request.parameter("name") else return reply("invalid path", 400)
        let encoded = request.parameter("id") else return reply("invalid path", 400)
        if owner != principal: return reply("forbidden", 403)
        if not repositories.valid_name(name): return reply("invalid repository", 400)
        var id: u8[20]
        discard(git.decode_id(encoded, id) catch: return reply("invalid object id", 400))
        if request.method() == "PUT":
            let body = request.body() catch: return reply("invalid body", 400)
            defer body.release()
            let wire = body.value().bytes((i64)repositories.max_object_bytes) catch: return reply("invalid body", 400)
            let decoded = git.decode_object(wire) catch: return reply("invalid Git object", 400)
            var actual: u8[20]
            discard(git.hash_object(decoded.kind, decoded.payload, actual) catch: return reply("invalid Git object", 400))
            for i in 0..<(usize)20:
                if id[i] != actual[i]: return reply("object id mismatch", 400)
            repositories.put_object(self.database.value(), principal, owner, name, wire, actual) catch failure:
                if failure.code == auth.missing: return reply("repository not found", 404)
                if failure.code == auth.invalid: return reply("invalid object", 400)
                if failure.code == auth.conflict: return reply("object conflict", 409)
                return reply("object storage unavailable", 503)
            return reply(encoded)
        let value = repositories.get_object(self.database.value(), principal, owner, name, id) catch failure:
            if failure.code == auth.missing: return reply("object not found", 404)
            return reply("object storage unavailable", 503)
        defer value.release()
        return binary_reply(value.value().bytes(), "application/octet-stream")

    func git_http(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let request = view.value()
        let token = bearer(request) catch: return reply("unauthorized", 401)
        let who = self.authority.value().verify(token) catch: return reply("unauthorized", 401)
        defer who.release()
        let principal = who.value().text_at() catch: return reply("internal error", 500)
        let owner = request.parameter("owner") else return reply("invalid path", 400)
        let name = request.parameter("name") else return reply("invalid path", 400)
        if owner != principal: return reply("forbidden", 403)
        if not repositories.valid_name(name): return reply("invalid repository", 400)
        if request.method() == "GET" or request.method() == "HEAD":
            let service = (request.query("service") catch: return reply("invalid service", 400)) else return reply("service required", 400)
            if service != "git-receive-pack" and service != "git-upload-pack": return reply("unsupported Git service", 403)
            let upload = service == "git-upload-pack"
            let output = alloc u8[4194304] in memory.heap catch: return reply("internal error", 500)
            defer free(output) in memory.heap
            let n = repositories.advertise_receive(self.database.value(), principal, owner, name, output, upload) catch failure:
                if failure.code == auth.missing: return reply("repository not found", 404)
                return reply("discovery failed", 503)
            return binary_reply(output[..<n], "application/x-git-upload-pack-advertisement" if upload else "application/x-git-receive-pack-advertisement")
        let content_type = (request.header("Content-Type") catch: return reply("invalid content type", 415)) else return reply("content type required", 415)
        if strings.ends_with(request.path(), "/git-upload-pack"):
            if content_type != "application/x-git-upload-pack-request": return reply("unsupported content type", 415)
            let body = request.body() catch: return reply("invalid body", 400)
            defer body.release()
            let wire = body.value().bytes(1048576) catch: return reply("invalid fetch body", 400)
            discard(git.decode_fetch(wire) catch: return reply("invalid fetch request", 400))
            let output = alloc u8[67108864] in memory.heap catch: return reply("internal error", 500)
            defer free(output) in memory.heap
            let n = repositories.upload_pack(self.database.value(), principal, owner, name, wire, output) catch:
                return reply("fetch rejected", 403)
            return binary_reply(output[..<n], "application/x-git-upload-pack-result")
        if content_type != "application/x-git-receive-pack-request": return reply("unsupported content type", 415)
        let body = request.body() catch: return reply("invalid body", 400)
        defer body.release()
        let wire = body.value().bytes((i64)repositories.max_object_bytes) catch: return reply("invalid body", 400)
        let commands = git.decode_push(wire) catch: return reply("invalid push request", 400)
        var report = false
        var start: usize = 0
        for i in 0..<commands.capabilities.length + 1:
            if i == commands.capabilities.length or commands.capabilities.bytes[i] == ' ':
                if (str)commands.capabilities.bytes[start..<i] == "report-status": report = true
                start = i + 1
        # Reserve bounded status storage before any ref mutation. The parser can
        # return 64 names of up to 4096 bytes, even when policy rejects them.
        let output = alloc u8[270336] in memory.heap catch: return reply("internal error", 500)
        defer free(output) in memory.heap
        var accepted = true
        discard(repositories.receive_pack(self.database.value(), principal, owner, name, wire) catch:
            accepted = false
            recover 0)
        if not report:
            if not accepted: return reply("push rejected", 409)
            return binary_reply(b"", "application/x-git-receive-pack-result")
        var used = git.encode_packet(git.PacketKind.data, b"unpack ok\n" if accepted else b"unpack rejected\n", output) catch: return reply("internal error", 500)
        for i in 0..<commands.count:
            let command = commands.at(i) catch: return reply("invalid push", 400)
            var line: u8[4352]
            let text = format(line, f"ok {command.name}\n" if accepted else f"ng {command.name} transaction rejected\n") catch: return reply("internal error", 500)
            used += git.encode_packet(git.PacketKind.data, text.bytes, output[used..]) catch: return reply("internal error", 500)
        used += git.encode_packet(git.PacketKind.flush, b"", output[used..]) catch: return reply("internal error", 500)
        return binary_reply(output[..<used], "application/x-git-receive-pack-result")

let app_type = interop.Type[App]("registry", App.close)

func store_token() -> str!:
    let token = os.env((c.str)"LUCE_REGISTRY_STORE_TOKEN") else error(auth.invalid, "LUCE_REGISTRY_STORE_TOKEN is required")
    if token.length == 0: error(auth.invalid, "empty store token")
    return token

func configure(socket: str) -> interop.Outcome[http.Application]:
    let database = db.Database.connect(socket, store_token() catch failure: trap(failure.message)) catch failure: trap(failure.message)
    let authority = auth.Authority.attach(database.value().store() catch failure: trap(failure.message)) catch failure:
        database.release()
        trap(failure.message)
    let native = new App(database = database, authority = authority) catch failure:
        authority.release()
        database.release()
        trap(failure.message)
    let app = interop.Reference[App].adopt(native, app_type) catch failure: trap(failure.message)
    defer app.release()
    var router = http.Router() catch failure: trap(failure.message)
    defer router.close()
    let health = http.Handler.bind(app, App.health) catch failure: trap(failure.message)
    defer health.release()
    router.get("/health", health) catch failure: trap(failure.message)
    let identity = http.Handler.bind(app, App.identity) catch failure: trap(failure.message)
    defer identity.release()
    router.get("/v1/identity", identity) catch failure: trap(failure.message)
    let redeem = http.Handler.bind(app, App.redeem) catch failure: trap(failure.message)
    defer redeem.release()
    router.post("/v1/invites/redeem", redeem) catch failure: trap(failure.message)
    let login = http.Handler.bind(app, App.login) catch failure: trap(failure.message)
    defer login.release()
    router.post("/v1/sessions", login) catch failure: trap(failure.message)
    let logout = http.Handler.bind(app, App.logout) catch failure: trap(failure.message)
    defer logout.release()
    router.post("/v1/sessions/revoke", logout) catch failure: trap(failure.message)
    let create_repository = http.Handler.bind(app, App.create_repository) catch failure: trap(failure.message)
    defer create_repository.release()
    router.post("/v1/repositories", create_repository) catch failure: trap(failure.message)
    let object = http.Handler.bind(app, App.object) catch failure: trap(failure.message)
    defer object.release()
    router.put("/v1/repositories/{owner}/{name}/objects/{id}", object) catch failure: trap(failure.message)
    router.get("/v1/repositories/{owner}/{name}/objects/{id}", object) catch failure: trap(failure.message)
    let git_http = http.Handler.bind(app, App.git_http) catch failure: trap(failure.message)
    defer git_http.release()
    router.get("/git/{owner}/{name}/info/refs", git_http) catch failure: trap(failure.message)
    router.post("/git/{owner}/{name}/git-receive-pack", git_http) catch failure: trap(failure.message)
    router.post("/git/{owner}/{name}/git-upload-pack", git_http) catch failure: trap(failure.message)
    let result = router.application() catch failure: trap(failure.message)
    return interop.Outcome[http.Application].success(interop.Owned[http.Application](result, result.owner))

func run(arguments: str[]) -> i32!:
    if arguments.length != 3: return 2
    var port: i64 = 0
    for byte in arguments[2].bytes:
        if byte < '0' or byte > '9': return 2
        port = port * 10 + (i64)(byte - '0')
        if port > 65535: return 2
    if arguments[2].length == 0: return 2
    let owner = try db.Database.open(arguments[1], try store_token())
    defer owner.release()
    let authority = try auth.Authority.attach(try owner.value().store())
    defer authority.release()
    try repositories.initialize(owner.value())
    try owner.value().listen()
    var socket_buffer: u8[4096]
    let socket = try format(socket_buffer, f"{arguments[1]}.sock")
    var options = http.ServerConfig(address = "127.0.0.1", port = port, network_workers = 2, application_workers = 2,
        body_limit = (i64)repositories.max_object_bytes, memory_body_limit = 65536,
        response_limit = (i64)repositories.max_object_bytes)
    var server = try http.Server(options, interop.WorkerEntry[str, unit, unit].native(configure), socket)
    defer server.close()
    try server.shutdown_on_signals()
    try server.start()
    print(f"READY {try server.port()}")
    try server.run()
    return 0

pub func main(arguments: str[]) -> i32!:
    let result = try run(arguments)
    return ownership.finish_run(result)
