## Local invited-account HTTP API. Loopback only. X-Forwarded-For is never identity.
import http
import interop
import db
import auth
import ownership

func failed(code: ErrorCode, message: str) -> interop.Outcome[interop.Reference[http.Response]]:
    let copied = interop.copy_text(message) catch failure:
        return interop.Outcome[interop.Reference[http.Response]].failure(failure.code, interop.Owned[str]("error text allocation failed"))
    return interop.Outcome[interop.Reference[http.Response]].failure(code, copied)

func reply(text: str, status: i64 = 200) -> interop.Outcome[interop.Reference[http.Response]]:
    let value = http.Response.bytes(text.bytes, "text/plain; charset=utf-8", status) catch failure:
        return failed(failure.code, failure.message)
    return interop.Outcome[interop.Reference[http.Response]].success(interop.Owned[interop.Reference[http.Response]](value, &value.owner.header))

func hex32(digest: const u8[], out: u8[]):
    let digits = b"0123456789abcdef"
    for i in 0..<(usize)32:
        out[i * 2] = digits[(usize)(digest[i] >> 4)]
        out[i * 2 + 1] = digits[(usize)(digest[i] & 15)]

struct App:
    var database: db.Database

    mutating func close():
        self.database.close()

    func health(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        discard(view)
        return reply("ok")

    func identity(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let request = view.value()
        let authorization = request.header("Authorization") catch failure: return failed(failure.code, failure.message)
        let forwarded = request.header("X-Forwarded-For") catch failure: return failed(failure.code, failure.message)
        let git = request.header("Git-Protocol") catch failure: return failed(failure.code, failure.message)
        var text: u8[512]
        var n: usize
        let auth_text = authorization else ""
        let forward_text = forwarded else ""
        let git_text = git else ""
        let prefix = "identity=untrusted-proxy\nauthorization="
        for i in 0..<prefix.length:
            text[n] = prefix.bytes[i]
            n += 1
        for i in 0..<auth_text.length:
            text[n] = auth_text.bytes[i]
            n += 1
        let mid = "\nforwarded="
        for i in 0..<mid.length:
            text[n] = mid.bytes[i]
            n += 1
        for i in 0..<forward_text.length:
            text[n] = forward_text.bytes[i]
            n += 1
        let git_prefix = "\ngit-protocol="
        for i in 0..<git_prefix.length:
            text[n] = git_prefix.bytes[i]
            n += 1
        for i in 0..<git_text.length:
            text[n] = git_text.bytes[i]
            n += 1
        return reply((str)text[..<n])

    mutating func redeem(view: interop.View[http.Request]) -> interop.Outcome[interop.Reference[http.Response]]:
        let body = view.value().body() catch failure: return failed(failure.code, failure.message)
        defer body.release()
        let payload = body.value().bytes(4096) catch failure: return failed(failure.code, failure.message)
        let invite = auth.decode_invite(payload) catch failure: return reply("invalid-invite", 400)
        var digest: u8[32]
        discard(auth.token_digest(invite.code.bytes, digest) catch failure: return failed(failure.code, failure.message))
        var key: u8[80]
        let head = b"invite/"
        for i in 0..<head.length: key[i] = head[i]
        hex32(digest, key[7..<71])
        let tx = self.database.begin() catch failure: return failed(failure.code, failure.message)
        defer tx.release()
        tx.value().insert((str)key[..<71], b"used") catch failure:
            if failure.code == db.conflict: return reply("invite-used", 409)
            return failed(failure.code, failure.message)
        tx.value().commit() catch failure: return failed(failure.code, failure.message)
        return reply("registered", 201)

pub let app_type: interop.Type[App] = interop.Type[App]("registry", App.close)

func configure(data: str) -> interop.Outcome[http.Application]:
    var opened = db.Database(data) catch failure: trap(failure.message)
    opened.initialize_schema("schema", "registry") catch failure: trap(failure.message)
    var native = new App(database = opened) catch failure: trap(failure.message)
    let app = interop.Reference[App].adopt(native, app_type) catch failure: trap(failure.message)
    defer app.release()
    var router = http.Router() catch failure: trap(failure.message)
    defer router.close()
    let health = http.Handler.bind(app, App.health) catch failure: trap(failure.message)
    defer health.release()
    router.get("/health", health) catch failure: trap(failure.message)
    let identity = http.Handler.bind(app, App.identity) catch failure: trap(failure.message)
    defer identity.release()
    router.get("/v1/identity", identity) catch failure: trap(failure.message)
    let redeem = http.Handler.bind_mutating(app, App.redeem) catch failure: trap(failure.message)
    defer redeem.release()
    router.post("/v1/invites/redeem", redeem) catch failure: trap(failure.message)
    let result = router.application() catch failure: trap(failure.message)
    return interop.Outcome[http.Application].success(interop.Owned[http.Application](result, result.owner))

pub func main(arguments: str[]) -> i32!:
    if arguments.length < 2: return 2
    var port: i64
    if arguments.length >= 3:
        var i: usize
        while i < arguments[2].length:
            let c = arguments[2].bytes[i]
            if c < '0' or c > '9': return 2
            port = port * 10 + (i64)(c - '0')
            i += 1
    var options = http.ServerConfig(address = "127.0.0.1", port = port, network_workers = 1, application_workers = 1,
        body_limit = 65536, memory_body_limit = 65536)
    var server = try http.Server(options, interop.WorkerEntry[str, unit, unit].native(configure), arguments[1])
    defer server.close()
    try server.shutdown_on_signals()
    try server.start()
    print(f"READY {try server.port()}")
    try server.run()
    return ownership.finish_run(0)
