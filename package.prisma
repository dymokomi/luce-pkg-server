    def dependency "luce-prism" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-prism"
    }

    def dependency "luce-git" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-git"
    }

    def dependency "luce-crypto" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-crypto"
    }

    def dependency "luce-pkg" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-pkg"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
