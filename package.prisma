#prisma 4.0
def package "luce-pkg-server" {
    str owner = "dymokomi"
    str version = "0.2.3"
    str kind = "package"
    str language = "luce-base"
    str description = "The registry behind pkg.luciaos.com: a Git host and package index for Luce and Luce Base."
    str readme = "README.md"

    def export "registry" {
        str module = "luce_pkg_server.registry"
    }

    def export "admin" {
        str module = "luce_pkg_server.admin"
    }

    def export "repositories" {
        str module = "luce_pkg_server.repositories"
    }

    def export "http_credentials" {
        str module = "luce_pkg_server.http_auth"
    }

    def export "rate_limit" {
        str module = "luce_pkg_server.rate_limit"
    }

    def dependency "luce-server" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-server"
